# Frontend configuration (all optional).
#
# Base URL for the backend API. The client never hardcodes a host, so this is the single
# place to point the interface at a different backend.
#
# Local development with the Vite dev proxy (default when unset):
VITE_API_BASE_URL=/api

# Direct backend connection:
# VITE_API_BASE_URL=http://localhost:8000/api
